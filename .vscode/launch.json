{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debug: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "MCP_LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Demo App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent-framework/demo/src/main.py",
            "console": "integratedTerminal",
            "env": {
                "MCP_LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Demo MCP",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fastmcp/demo/server.py",
            "cwd": "${workspaceFolder}/fastmcp/demo",
            "console": "integratedTerminal",
            "env": {
                "MCP_LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}/fastmcp/demo",
                "HOST": "127.0.0.1",
                "PORT": "8100"
            },
            "justMyCode": true
        },
        {
            "name": "Demo DevUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent-framework/demo/src/devui.py",
            "console": "integratedTerminal",
            "env": {
                "MCP_LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
    ]
}