# User
USERNAME=kento

# Model settings
## OpenAI
FOUNDRY_PROJECT_ENDPOINT=https://<your_openai_endpoint>.azure.com/api/projects/<your_project_id>

## Anthropic
ANTHROPIC_FOUNDRY_RESOURCE=<your_project_id>
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

## Gemini
GEMINI_API_KEY=<your_gemini_api_key>
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<your_google_project_id>
GOOGLE_CLOUD_LOCATION=<your_google_cloud_location>

# OpenTelemetry settings
## Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000-00000-0000;IngestionEndpoint=xxxxx
## サービス ID
OTEL_SERVICE_NAME=service-name